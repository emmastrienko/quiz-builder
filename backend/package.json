{
  "name": "quiz-builder-backend",
  "version": "1.0.0",
  "description": "Backend API for the Quiz Builder application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"{src,tests,api}/**/*.ts\"",
    "format": "prettier --write \"{src,tests,api,prisma}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,api,prisma}/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^27.0.1",
    "eslint": "^9.19.0",
    "pg": "^8.23.1",
    "prettier": "^3.4.2",
    "prisma": "^6.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^5.0.5"
  }
}
